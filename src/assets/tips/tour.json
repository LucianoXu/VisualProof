 "captions": [
  {
   "start": 4.1,
   "end": 7.9,
   "text": "Search the theorem to review: press /."
  },
  {
   "start": 7.9,
   "end": 11.9,
   "text": "There are two MainTheorems: take the one in Dim24."
  },
  {
   "start": 11.9,
   "end": 15.866666666666667,
   "text": "Mark it as the target of the review."
  },
  {
   "start": 15.866666666666667,
   "end": 19.466666666666665,
   "text": "The side panel lists the targets, with their progress."
  },
  {
   "start": 19.466666666666665,
   "end": 25.333333333333332,
   "text": "Rests on · Uses: everything the theorem uses."
  },
  {
   "start": 25.333333333333332,
   "end": 28.833333333333332,
   "text": "Zoom in: a view of just that, in a tab of its own."
  },
  {
   "start": 28.833333333333332,
   "end": 31.833333333333332,
   "text": "The view is laid out for what it holds alone."
  },
  {
   "start": 34.13333333333333,
   "end": 39.5,
   "text": "Drag a cluster with Ctrl held: it stays there, for everyone."
  },
  {
   "start": 39.5,
   "end": 46.53333333333333,
   "text": "Or let the lock go with l, and drag without Ctrl."
  },
  {
   "start": 46.53333333333333,
   "end": 53.666666666666664,
   "text": "Double-click a circle to fold it to a point; again to open."
  },
  {
   "start": 53.666666666666664,
   "end": 58.7,
   "text": "Space opens the source of what is selected."
  },
  {
   "start": 58.7,
   "end": 62.5,
   "text": "Rest on a name: Lean says what it is."
  },
  {
   "start": 62.5,
   "end": 66.06666666666666,
   "text": "Click it to go there: its source, its panel."
  },
  {
   "start": 66.06666666666666,
   "end": 69.13333333333334,
   "text": "Keys: the definitions that carry what it says."
  },
  {
   "start": 69.13333333333334,
   "end": 84.53333333333333,
   "text": "Mark each as a key with the mouse, in its panel."
  },
  {
   "start": 84.53333333333333,
   "end": 92.8,
   "text": "Rests on · Keys lights them, joined to the target."
  },
  {
   "start": 93.4,
   "end": 96.1,
   "text": "Selection: the statement alone."
  },
  {
   "start": 96.1,
   "end": 98.9,
   "text": "Least effort — you trust every name in it."
  },
  {
   "start": 98.9,
   "end": 101.36666666666666,
   "text": "Keys: the few that carry the meaning."
  },
  {
   "start": 101.36666666666666,
   "end": 103.43333333333334,
   "text": "Little effort, good confidence."
  },
  {
   "start": 103.43333333333334,
   "end": 105.63333333333334,
   "text": "TCB: everything it rests on."
  },
  {
   "start": 105.63333333333334,
   "end": 107.63333333333334,
   "text": "Most effort, most confidence."
  },
  {
   "start": 107.63333333333334,
   "end": 111.3,
   "text": "Choose how far to read: the counts say what each costs."
  },
  {
   "start": 111.3,
   "end": 116.6,
   "text": "Read a definition, then say what you think of it."
  },
  {
   "start": 116.6,
   "end": 125.96666666666667,
   "text": "Approve it, with why: the comment stays with it."
  },
  {
   "start": 125.96666666666667,
   "end": 129.73333333333332,
   "text": "The target's progress counts your approval."
  },
  {
   "start": 129.73333333333332,
   "end": 135.03333333333333,
   "text": "The Project tab: the whole codebase."
  },
  {
   "start": 135.03333333333333,
   "end": 138.66666666666666,
   "text": "Every board shows the same review."
  },
  {
   "start": 138.66666666666666,
   "end": 145.56666666666666,
   "text": "Share → AI agent: a token, and a prompt for it."
  },
  {
   "start": 145.56666666666666,
   "end": 148.76666666666668,
   "text": "Paste the prompt into your agent: it joins here."
  },
  {
   "start": 148.76666666666668,
   "end": 152,
   "text": "The token is the agent's own: revoke it here."
  },
  {
   "start": 152.7,
   "end": 160.13333333333333,
   "text": "Click the agent to follow it, and ask."
  },
  {
   "start": 160.13333333333333,
   "end": 165.83333333333334,
   "text": "It reads the code, and takes your view along."
  },
  {
   "start": 165.83333333333334,
   "end": 171.33333333333334,
   "text": "Its answer names what it explains."
  },
  {
   "start": 172.13333333333333,
   "end": 178.23333333333332,
   "text": "Library: add a paper about the code."
  },
  {
   "start": 178.23333333333332,
   "end": 191.53333333333333,
   "text": "Link it to the theorem, at its page."
  },
  {
   "start": 191.53333333333333,
   "end": 199.73333333333332,
   "text": "Pin a note on the target: where to start."
  },
  {
   "start": 199.73333333333332,
   "end": 207.66666666666666,
   "text": "Export prints a view: here, the target's TCB."
  },
  {
   "start": 207.66666666666666,
   "end": 212.26666666666668,
   "text": "Drag a section to change the document's order."
  },
  {
   "start": 212.26666666666668,
   "end": 219.23333333333332,
   "text": "Typeset: the PDF follows the order you set."
  },
  {
   "start": 219.23333333333332,
   "end": 224,
   "text": "Artwork: the board as a picture to keep."
  },
  {
   "start": 224,
   "end": 235.36666666666667,
   "text": "Frame it, then save it as PNG or SVG."
  }
 ]
}
