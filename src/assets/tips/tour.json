 "captions": [
  {
   "start": 4.1,
   "end": 6.633333333333334,
   "text": "Search the theorem to review: press /."
  },
  {
   "start": 6.633333333333334,
   "end": 9.966666666666667,
   "text": "There are two MainTheorems: take the one in Dim24."
  },
  {
   "start": 9.966666666666667,
   "end": 13.166666666666666,
   "text": "Mark it as the target of the review."
  },
  {
   "start": 13.166666666666666,
   "end": 16.766666666666666,
   "text": "The side panel lists the targets, with their progress."
  },
  {
   "start": 16.766666666666666,
   "end": 21.933333333333334,
   "text": "Rests on · Uses: everything the theorem uses."
  },
  {
   "start": 21.933333333333334,
   "end": 25.266666666666666,
   "text": "Zoom in: a view of just that, in a tab of its own."
  },
  {
   "start": 25.266666666666666,
   "end": 28.266666666666666,
   "text": "The view is laid out for what it holds alone."
  },
  {
   "start": 30.166666666666668,
   "end": 34.7,
   "text": "Drag a cluster with Ctrl held: it stays there, for everyone."
  },
  {
   "start": 34.7,
   "end": 39.833333333333336,
   "text": "Or let the lock go with l, and drag without Ctrl."
  },
  {
   "start": 39.833333333333336,
   "end": 45.666666666666664,
   "text": "Double-click a circle to fold it to a point; again to open."
  },
  {
   "start": 45.666666666666664,
   "end": 49.7,
   "text": "Space opens its source, and its review box with it."
  },
  {
   "start": 49.7,
   "end": 52.86666666666667,
   "text": "Rest on a name: Lean says what it is."
  },
  {
   "start": 52.86666666666667,
   "end": 55.8,
   "text": "Click it to go there: its source, its panel."
  },
  {
   "start": 55.8,
   "end": 58.86666666666667,
   "text": "Keys: the definitions that carry what it says."
  },
  {
   "start": 58.86666666666667,
   "end": 70.19999999999999,
   "text": "Mark each as a key, in its source or its panel."
  },
  {
   "start": 70.19999999999999,
   "end": 76.9,
   "text": "Rests on · Keys lights them, joined to the target."
  },
  {
   "start": 77.30000000000001,
   "end": 79.66666666666667,
   "text": "Selection: the statement alone."
  },
  {
   "start": 79.66666666666667,
   "end": 82.46666666666667,
   "text": "Least effort — you trust every name in it."
  },
  {
   "start": 82.46666666666667,
   "end": 84.93333333333334,
   "text": "Keys: the few that carry the meaning."
  },
  {
   "start": 84.93333333333334,
   "end": 87.00000000000001,
   "text": "Little effort, good confidence."
  },
  {
   "start": 87.00000000000001,
   "end": 89.00000000000001,
   "text": "TCB: everything it rests on."
  },
  {
   "start": 89.00000000000001,
   "end": 91.00000000000001,
   "text": "Most effort, most confidence."
  },
  {
   "start": 91.00000000000001,
   "end": 94.66666666666667,
   "text": "Choose how far to read: the counts say what each costs."
  },
  {
   "start": 94.66666666666667,
   "end": 98.23333333333333,
   "text": "Read a definition, then say what you think of it."
  },
  {
   "start": 98.23333333333333,
   "end": 104.26666666666668,
   "text": "Approve it, with why: the comment stays with it."
  },
  {
   "start": 104.26666666666668,
   "end": 107.06666666666668,
   "text": "Changed your mind? Withdraw takes it back."
  },
  {
   "start": 107.06666666666668,
   "end": 110.53333333333335,
   "text": "The target's progress counts your approval."
  },
  {
   "start": 110.53333333333333,
   "end": 114.63333333333333,
   "text": "The Project tab: the whole codebase."
  },
  {
   "start": 114.63333333333333,
   "end": 117.26666666666667,
   "text": "Every board shows the same review."
  },
  {
   "start": 117.26666666666667,
   "end": 122.89999999999999,
   "text": "Share → AI agent: a token, and a prompt for it."
  },
  {
   "start": 122.89999999999999,
   "end": 126.1,
   "text": "Paste the prompt into your agent: it joins here."
  },
  {
   "start": 126.1,
   "end": 129.09999999999997,
   "text": "The token is the agent's own: revoke it here."
  },
  {
   "start": 129.6,
   "end": 136.63333333333335,
   "text": "Its menu → Talk: your private channel with it."
  },
  {
   "start": 136.63333333333335,
   "end": 140.23333333333335,
   "text": "It reads the code; its state says what it does."
  },
  {
   "start": 140.23333333333335,
   "end": 142.70000000000002,
   "text": "Its answer links to what it explains."
  },
  {
   "start": 142.70000000000002,
   "end": 145.8,
   "text": "Click the link: your board goes there."
  },
  {
   "start": 146.93333333333334,
   "end": 151.56666666666666,
   "text": "Library: add a paper about the code."
  },
  {
   "start": 151.56666666666666,
   "end": 162.8,
   "text": "Link it to the theorem, at its page."
  },
  {
   "start": 162.8,
   "end": 167.20000000000002,
   "text": "Space: its source, and the paper beside it at its page."
  },
  {
   "start": 167.20000000000002,
   "end": 173.53333333333333,
   "text": "Pin a note on the target: where to start."
  },
  {
   "start": 173.53333333333333,
   "end": 180.96666666666667,
   "text": "Export prints a view: here, the target's TCB."
  },
  {
   "start": 180.96666666666667,
   "end": 184.86666666666667,
   "text": "Drag a section to change the document's order."
  },
  {
   "start": 184.86666666666667,
   "end": 191.8,
   "text": "Typeset: the PDF follows the order you set."
  },
  {
   "start": 191.8,
   "end": 195.86666666666667,
   "text": "Artwork: the board as a picture to keep."
  },
  {
   "start": 195.86666666666667,
   "end": 205.8,
   "text": "Frame it, then save it as PNG or SVG."
  }
 ]
}
