{
  "name": "visualproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "See a Lean codebase's declaration graph and the TCB of its theorems.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucianoXu/VisualProof.git"
  },
  "bin": {
    "visualproof": "src/server/main.ts"
  },
  "scripts": {
    "build:web": "esbuild app=src/web/src/main.ts layout=src/web/src/layoutworker.ts edges=src/web/src/edgeworker.ts pdfworker=node_modules/pdfjs-dist/legacy/build/pdf.worker.min.mjs --bundle --format=esm --target=es2022,safari16 --sourcemap --outdir=dist/web",
    "serve": "node src/server/main.ts serve",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test --import ./test/setup.ts \"test/*.test.ts\"",
    "test:toolchains": "node scripts/test-toolchains.mjs",
    "golden:update": "VP_GOLDEN_UPDATE=1 node --test --import ./test/setup.ts test/compat.test.ts"
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "d3-hierarchy": "^3.1.2",
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  }
}
