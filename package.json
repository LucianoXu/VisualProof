{
  "name": "visualproof",
  "version": "0.4.2",
  "type": "module",
  "description": "See a Lean codebase's declaration graph and the TCB of its theorems.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucianoXu/VisualProof.git"
  },
  "bin": {
    "visualproof": "dist/server/main.js"
  },
  "files": [
    "dist/",
    "docs/agent-api/",
    "test/toolchains.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "serve": "node src/server/main.ts serve",
    "showcase": "node scripts/showcase.mjs",
    "tips:record": "node scripts/tips-record.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test --import ./test/setup.ts \"test/*.test.ts\"",
    "test:toolchains": "node scripts/test-toolchains.mjs",
    "test:updates": "node scripts/test-updates.mjs",
    "golden:update": "VP_GOLDEN_UPDATE=1 node --test --import ./test/setup.ts test/compat.test.ts"
  },
  "engines": {
    "node": "^22.18.0 || >=24.2.0"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2",
    "d3-hierarchy": "^3.1.2",
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  }
}
